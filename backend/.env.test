# Test Environment Configuration
# This file is used for running tests
# Copy this to .env.test.local and customize for your local test environment

NODE_ENV=test

# Database - MUST include 'test' in the name to prevent accidental use of production database
DATABASE_URL=postgresql://test:test@localhost:5432/splittab_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (use different secrets for testing)
JWT_ACCESS_SECRET=test-access-secret-change-in-production
JWT_REFRESH_SECRET=test-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3001

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Session
SESSION_SECRET=test-session-secret-change-in-production

# OAuth (Test credentials - not real)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Email (Use test service like Ethereal or MailHog for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=noreply@test.splittab.com

# Logging
LOG_LEVEL=error

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads/test

# Rate Limiting (More permissive for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

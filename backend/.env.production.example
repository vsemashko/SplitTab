# SplitTab Production Environment Configuration
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control

# ==============================================================================
# Environment
# ==============================================================================
NODE_ENV=production

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=3000
API_VERSION=v1

# ==============================================================================
# Database (Use managed PostgreSQL service in production)
# ==============================================================================
# Format: postgresql://username:password@host:port/database?schema=public
# Examples:
#   - Railway: postgresql://postgres:PASSWORD@REGION.railway.app:PORT/railway
#   - AWS RDS: postgresql://username:password@instance.REGION.rds.amazonaws.com:5432/dbname
#   - Heroku: (provided automatically)
DATABASE_URL=postgresql://username:password@host:port/database

# ==============================================================================
# Redis (Use managed Redis service in production)
# ==============================================================================
# Format: redis://[[username:]password@]host:port[/database]
# Examples:
#   - Railway: redis://default:PASSWORD@REGION.railway.app:PORT
#   - AWS ElastiCache: redis://cache.REGION.amazonaws.com:6379
#   - Upstash: redis://:PASSWORD@REGION.upstash.io:PORT
REDIS_URL=redis://username:password@host:port

# ==============================================================================
# JWT Secrets (Generate with: openssl rand -base64 64)
# ==============================================================================
# CRITICAL: Use cryptographically secure random values (64+ characters)
JWT_ACCESS_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_SECURE_RANDOM_STRING_MIN_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://www.yourdomain.com

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100      # requests per window

# ==============================================================================
# Email Service (SendGrid or Resend)
# ==============================================================================
EMAIL_FROM=noreply@yourdomain.com
EMAIL_API_KEY=your_sendgrid_or_resend_api_key_here

# ==============================================================================
# OAuth Providers
# ==============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Apple Sign In
APPLE_CLIENT_ID=com.yourdomain.splittab
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# ==============================================================================
# AWS Configuration
# ==============================================================================
# S3 for file storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=splittab-receipts-production

# Textract for OCR (alternative to Google Vision)
AWS_TEXTRACT_REGION=us-east-1

# ==============================================================================
# Google Cloud Platform
# ==============================================================================
# Google Cloud Vision API for OCR
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gcp-service-account.json

# ==============================================================================
# OCR Configuration
# ==============================================================================
OCR_PROVIDER=google                    # google, aws, or both
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_MAX_RETRIES=3

# ==============================================================================
# Background Jobs (Bull Queue)
# ==============================================================================
BULL_REDIS_HOST=your-redis-host.com
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=your_redis_password
OCR_QUEUE_CONCURRENCY=5

# ==============================================================================
# Monitoring & Error Tracking
# ==============================================================================
# Sentry.io for error tracking
SENTRY_DSN=https://YOUR_SENTRY_KEY@o123456.ingest.sentry.io/123456
LOG_LEVEL=info

# ==============================================================================
# File Upload
# ==============================================================================
UPLOAD_DIR=./uploads/receipts
MAX_FILE_SIZE=5242880                  # 5MB in bytes

# ==============================================================================
# Stripe (Phase 2 - Payment Integration)
# ==============================================================================
# STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY
# STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

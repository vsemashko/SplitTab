// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  emailVerified       Boolean   @default(false)
  passwordHash        String?
  name                String
  profilePictureUrl   String?
  phoneNumber         String?
  phoneVerified       Boolean   @default(false)

  // Preferences
  defaultCurrency     String    @default("USD") @db.Char(3)
  timezone            String    @default("UTC")
  language            String    @default("en") @db.Char(2)

  // OAuth
  googleId            String?   @unique
  appleId             String?   @unique
  oauthProvider       String?
  oauthId             String?

  // Security
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?

  // Password Reset
  passwordResetToken  String?
  passwordResetExpires DateTime?

  // Email Verification
  emailVerificationToken String?
  emailVerificationExpires DateTime?

  // Metadata
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  groupsOwned         Group[]           @relation("GroupCreator")
  groupMemberships    GroupMember[]
  expensesCreated     Expense[]         @relation("ExpenseCreator")
  expenseParticipations ExpenseParticipant[]
  paymentsAsPayer     Settlement[]      @relation("PaymentPayer")
  paymentsAsPayee     Settlement[]      @relation("PaymentPayee")
  sessions            Session[]
  notifications       Notification[]
  receipts            Receipt[]

  @@index([email])
  @@index([googleId])
  @@index([appleId])
  @@index([createdAt])
}

// Groups table
model Group {
  id                      String    @id @default(uuid())
  name                    String
  description             String?
  groupType               String    @default("other")
  imageUrl                String?

  // Settings
  defaultCurrency         String    @default("USD") @db.Char(3)
  simplifyDebts           Boolean   @default(true)
  requireExpenseApproval  Boolean   @default(false)

  // Metadata
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  // Relations
  creator                 User            @relation("GroupCreator", fields: [createdBy], references: [id])
  members                 GroupMember[]
  expenses                Expense[]
  settlements             Settlement[]

  @@index([createdBy])
  @@index([createdAt])
  @@index([groupType])
}

// Group Members junction table
model GroupMember {
  id          String    @id @default(uuid())
  groupId     String
  userId      String
  role        String    @default("member")

  // Metadata
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  invitedBy   String?

  // Relations
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([joinedAt])
}

// Expenses table
model Expense {
  id              String    @id @default(uuid())
  groupId         String?

  // Expense details
  amount          Decimal   @db.Decimal(15, 2)
  currency        String    @default("USD") @db.Char(3)
  description     String
  category        String
  notes           String?
  receiptUrl      String?

  // Dates
  date            DateTime

  // Payer
  paidById        String

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Split details
  splitMethod     String    @default("equal")

  // Relations
  group           Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  paidBy          User                @relation("ExpenseCreator", fields: [paidById], references: [id])
  participants    ExpenseParticipant[]
  receipts        Receipt[]

  @@index([groupId])
  @@index([paidById])
  @@index([date(sort: Desc)])
  @@index([category])
  @@index([createdAt])
}

// Expense Participants junction table
model ExpenseParticipant {
  id          String    @id @default(uuid())
  expenseId   String
  userId      String

  // Financial details
  paidAmount  Decimal   @default(0) @db.Decimal(15, 2)
  owedAmount  Decimal   @default(0) @db.Decimal(15, 2)

  // Metadata
  createdAt   DateTime  @default(now())

  // Relations
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

// Settlements table
model Settlement {
  id                  String    @id @default(uuid())
  groupId             String?

  // Payment details
  payerId             String
  payeeId             String
  amount              Decimal   @db.Decimal(15, 2)
  currency            String    @default("USD") @db.Char(3)

  // Payment info
  paymentMethod       String?
  referenceNumber     String?
  notes               String?

  // Status
  status              String    @default("pending") // pending, confirmed, cancelled

  // Dates
  date                DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Payment provider details
  paymentProvider     String?
  paymentProviderId   String?
  paymentStatus       String?

  // Relations
  group               Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payer               User      @relation("PaymentPayer", fields: [payerId], references: [id])
  payee               User      @relation("PaymentPayee", fields: [payeeId], references: [id])

  @@index([payerId])
  @@index([payeeId])
  @@index([groupId])
  @@index([date])
  @@index([createdAt])
  @@index([status])
}

// Sessions table
model Session {
  id            String    @id @default(uuid())
  userId        String

  // Token details
  token         String    @unique
  deviceName    String?
  deviceType    String?
  userAgent     String?
  ipAddress     String?

  // Metadata
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revoked       Boolean   @default(false)

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([revoked])
}

// Receipts table
model Receipt {
  id                  String    @id @default(uuid())
  expenseId           String?   // Optional - receipt can exist before being attached to expense

  // File details
  fileName            String
  fileUrl             String
  fileSize            Int       // Size in bytes
  mimeType            String
  thumbnailUrl        String?

  // OCR status and results
  ocrStatus           String    @default("pending") // pending, processing, completed, failed
  ocrProcessedAt      DateTime?
  ocrConfidence       Float?    // Overall confidence score 0-1
  ocrData             Json?     // Raw OCR response
  ocrError            String?   // Error message if OCR failed

  // Extracted data from OCR
  merchantName        String?
  totalAmount         Decimal?  @db.Decimal(15, 2)
  currency            String?   @db.Char(3)
  receiptDate         DateTime?
  tax                 Decimal?  @db.Decimal(15, 2)
  tip                 Decimal?  @db.Decimal(15, 2)
  subtotal            Decimal?  @db.Decimal(15, 2)
  lineItems           Json?     // Array of line items with name, quantity, price

  // Metadata
  uploadedById        String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  expense             Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  uploadedBy          User      @relation(fields: [uploadedById], references: [id])

  @@index([expenseId])
  @@index([uploadedById])
  @@index([ocrStatus])
  @@index([createdAt])
  @@index([receiptDate])
}

// Notifications table
model Notification {
  id              String    @id @default(uuid())
  userId          String
  type            String    // receipt_processed, expense_created, payment_received, etc.
  title           String
  message         String
  data            Json?     // Additional context data
  read            Boolean   @default(false)
  readAt          DateTime?
  actionUrl       String?   // Deep link or URL for the notification
  priority        String    @default("normal") // low, normal, high, urgent
  category        String?   // categorize notifications (receipt, expense, payment, etc.)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime? // Optional expiration for time-sensitive notifications

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
  @@index([category])
}
